#include <windows.h>

// UAC shows FileDescription as the program name and this icon beside it
// when the client launches the helper elevated; with neither, the prompt
// names only "rpi-imager-writer.exe" and gives no reason to trust it.
IDI_ICON1 ICON DISCARDABLE "@RPI_IMAGER_ICON@"

1 VERSIONINFO
FILEVERSION @IMAGER_VERSION_MAJOR@,@IMAGER_VERSION_MINOR@,@IMAGER_VERSION_PATCH@,@IMAGER_VERSION_TWEAK@
PRODUCTVERSION @IMAGER_VERSION_MAJOR@,@IMAGER_VERSION_MINOR@,@IMAGER_VERSION_PATCH@,@IMAGER_VERSION_TWEAK@
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"
        {
            VALUE "CompanyName",     "@RPI_IMAGER_PUBLISHER_ORG@"
            VALUE "FileDescription", "Raspberry Pi Imager - write to storage devices"
            VALUE "ProductName",     "Raspberry Pi Imager"
            VALUE "FileVersion",     "@IMAGER_VERSION_STR@"
            VALUE "ProductVersion",  "@IMAGER_VERSION_STR@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1252
    }
}
