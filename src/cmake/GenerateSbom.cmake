# Writes SPDX 2.3 and CycloneDX 1.6 from sbom-inputs.cmake; inputs are listed
# in doc/sbom.md.

cmake_minimum_required(VERSION 3.22)

if(NOT SBOM_INPUTS OR NOT EXISTS "${SBOM_INPUTS}")
    message(FATAL_ERROR "GenerateSbom: SBOM_INPUTS not found: '${SBOM_INPUTS}'")
endif()
include("${SBOM_INPUTS}")

set(IMAGER_VERSION_STR "0.0.0-unknown")
if(SBOM_VERSION_VARS AND EXISTS "${SBOM_VERSION_VARS}")
    include("${SBOM_VERSION_VARS}")
endif()

set(_fields NAME VERSION SUPPLIER DOWNLOAD_LOCATION VCS_URL GIT_TAG COMMIT
    LICENSE LICENSE_TEXT PURL CPE TYPE DESCRIPTION ORIGIN RELATION USED_BY FILE_NAME PATHS)

string(CONFIGURE "${SBOM_OUTPUT_STEM}" SBOM_OUTPUT_STEM @ONLY)
string(CONFIGURE "${SBOM_ARTEFACT}" SBOM_ARTEFACT @ONLY)
# The extension stays, so the name says which file the SBOM covers and two
# artefacts differing only in extension cannot overwrite each other's.
if(SBOM_ARTEFACT AND NOT SBOM_OUTPUT_STEM)
    get_filename_component(SBOM_OUTPUT_STEM "${SBOM_ARTEFACT}" NAME)
endif()
if(NOT SBOM_LIFECYCLE)
    set(SBOM_LIFECYCLE build)
endif()

set(_imager_commit "")
if(SBOM_GIT_EXECUTABLE)
    execute_process(
        COMMAND "${SBOM_GIT_EXECUTABLE}" -C "${SBOM_SOURCE_DIR}" rev-parse HEAD
        RESULT_VARIABLE _rc
        OUTPUT_VARIABLE _out
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(_rc EQUAL 0 AND _out MATCHES "^[0-9a-f]+$")
        set(_imager_commit "${_out}")
    endif()
endif()

string(REGEX REPLACE "^.*-" "" _sbom_arch "${SBOM_PLATFORM}")
foreach(_id IN LISTS SBOM_COMPONENTS)
    foreach(_f IN LISTS _fields)
        string(REPLACE "@IMAGER_VERSION@" "${IMAGER_VERSION_STR}"
            SBOM_${_id}_${_f} "${SBOM_${_id}_${_f}}")
    endforeach()
    if("${SBOM_${_id}_PURL}" MATCHES "^pkg:github/raspberrypi/rpi-imager@"
       AND NOT SBOM_${_id}_COMMIT)
        set(SBOM_${_id}_COMMIT "${_imager_commit}")
    endif()
    # A library pkg-config did not find has no version.
    if("${SBOM_${_id}_CPE}" MATCHES "^cpe:2[.]3:[aho]:[^:]*:[^:]*::")
        set(SBOM_${_id}_CPE "")
    endif()
    string(REGEX REPLACE "@$" "" SBOM_${_id}_PURL "${SBOM_${_id}_PURL}")
    # Imager's own binaries are built per platform; the purl says which.
    if("${SBOM_${_id}_PURL}" MATCHES "^pkg:github/raspberrypi/rpi-imager@[^?]*$")
        string(APPEND SBOM_${_id}_PURL "?arch=${_sbom_arch}")
    endif()
endforeach()

# Plugin and QML directories hold only Qt's files.
function(_sbom_classify path qt_tree)
    get_filename_component(_base "${path}" NAME)
    set(_ver "")
    set(_sup "")
    set(_lic NOASSERTION)
    set(_cpe "")
    set(_desc "")
    if(qt_tree OR _base MATCHES "^(lib)?Qt6?[A-Za-z0-9]*([.]framework|[.]dll|([.][0-9]+)*[.]dylib|[.]so([.].*)?)$")
        set(_ver "${SBOM_QT_VERSION}")
        set(_sup "The Qt Company")
        set(_lic "LGPL-3.0-only")
        set(_cpe "cpe:2.3:a:qt:qt:${SBOM_QT_VERSION}:*:*:*:*:*:*:*")
        set(_desc "Qt runtime file deployed with the application")
    elseif(_base MATCHES "^(libgcc_s|libstdc[+][+])")
        if(SBOM_CXX_COMPILER_ID STREQUAL "GNU")
            set(_ver "${SBOM_CXX_COMPILER_VERSION}")
            set(_cpe "cpe:2.3:a:gnu:gcc:${_ver}:*:*:*:*:*:*:*")
        endif()
        set(_sup "Free Software Foundation")
        set(_lic "GPL-3.0-or-later WITH GCC-exception-3.1")
        set(_desc "GCC runtime library")
    elseif(_base MATCHES "^libwinpthread")
        set(_sup "mingw-w64 project")
        set(_lic "MIT")
        set(_desc "mingw-w64 winpthreads runtime")
    elseif(_base MATCHES "^[Dd]3[Dd][Cc]ompiler")
        set(_sup "Microsoft Corporation")
        set(_desc "Direct3D shader compiler deployed by windeployqt")
    elseif(_base MATCHES "^opengl32sw")
        set(_sup "The Mesa 3D Graphics Library project")
        set(_lic "MIT")
        set(_desc "Mesa llvmpipe software OpenGL, deployed by windeployqt")
    elseif(_base MATCHES "[.]so[.]([0-9][0-9.]*)$")
        set(_desc "Bundled shared library, soname version ${CMAKE_MATCH_1}; providing package unknown")
    else()
        set(_desc "Bundled file; providing package unknown")
    endif()
    set(_c_NAME "${_base}" PARENT_SCOPE)
    set(_c_VERSION "${_ver}" PARENT_SCOPE)
    set(_c_SUPPLIER "${_sup}" PARENT_SCOPE)
    set(_c_LICENSE "${_lic}" PARENT_SCOPE)
    set(_c_CPE "${_cpe}" PARENT_SCOPE)
    set(_c_DESCRIPTION "${_desc}" PARENT_SCOPE)
endfunction()

# One component per package and version; unidentified files get one each.
function(_sbom_add_bundled path name version supplier purl licence qt_tree)
    set(_cpe "")
    set(_desc "")
    if(name STREQUAL "")
        _sbom_classify("${path}" ${qt_tree})
        set(name "${_c_NAME}")
        set(version "${_c_VERSION}")
        set(supplier "${_c_SUPPLIER}")
        set(licence "${_c_LICENSE}")
        set(_cpe "${_c_CPE}")
        set(_desc "${_c_DESCRIPTION}")
        set(_key "${path}")
    else()
        set(_key "${name}-${version}")
        if(licence STREQUAL "")
            set(licence NOASSERTION)
        endif()
        # A system library registered at configure time names the same
        # package; qualifiers may differ, so only the package@version counts.
        string(REGEX REPLACE "[?].*$" "" _pv "${purl}")
        if(_pv MATCHES "^pkg:deb/")
            foreach(_c IN LISTS SBOM_COMPONENTS)
                string(REGEX REPLACE "[?].*$" "" _cpv "${SBOM_${_c}_PURL}")
                if(_cpv STREQUAL _pv)
                    set(_paths ${SBOM_${_c}_PATHS} "${path}")
                    set(SBOM_${_c}_PATHS "${_paths}" PARENT_SCOPE)
                    set(SBOM_${_c}_ORIGIN "bundled in the package" PARENT_SCOPE)
                    return()
                endif()
            endforeach()
        endif()
    endif()
    string(REGEX REPLACE "[^A-Za-z0-9.-]" "-" _id "bundled-${_key}")
    if(DEFINED SBOM_${_id}_NAME)
        set(SBOM_${_id}_PATHS "${SBOM_${_id}_PATHS};${path}" PARENT_SCOPE)
        return()
    endif()
    set(_type library)
    if(path MATCHES "[.](ttf|otf)$")
        set(_type data)
    endif()
    set(SBOM_${_id}_NAME "${name}" PARENT_SCOPE)
    set(SBOM_${_id}_VERSION "${version}" PARENT_SCOPE)
    set(SBOM_${_id}_SUPPLIER "${supplier}" PARENT_SCOPE)
    set(SBOM_${_id}_LICENSE "${licence}" PARENT_SCOPE)
    set(SBOM_${_id}_PURL "${purl}" PARENT_SCOPE)
    set(SBOM_${_id}_CPE "${_cpe}" PARENT_SCOPE)
    set(SBOM_${_id}_TYPE "${_type}" PARENT_SCOPE)
    set(SBOM_${_id}_DESCRIPTION "${_desc}" PARENT_SCOPE)
    set(SBOM_${_id}_ORIGIN "bundled in the package" PARENT_SCOPE)
    set(SBOM_${_id}_RELATION CONTAINS PARENT_SCOPE)
    set(SBOM_${_id}_USED_BY "${SBOM_ROOT}" PARENT_SCOPE)
    set(SBOM_${_id}_PATHS "${path}" PARENT_SCOPE)
    set(SBOM_COMPONENTS "${SBOM_COMPONENTS};${_id}" PARENT_SCOPE)
endfunction()

# Bundled paths are reported relative to the hashed tree, so files map to them.
set(_scan_prefix "")
if(SBOM_HASH_ROOT AND SBOM_SCAN_ROOT)
    file(RELATIVE_PATH _scan_prefix "${SBOM_HASH_ROOT}" "${SBOM_SCAN_ROOT}")
    if(_scan_prefix MATCHES "^[.][.]")
        set(_scan_prefix "")
    elseif(_scan_prefix)
        string(APPEND _scan_prefix "/")
    endif()
endif()

if(SBOM_SCAN_ROOT AND SBOM_SCAN_DIRS)
    foreach(_d IN LISTS SBOM_SCAN_DIRS)
        if(_d STREQUAL ".")
            set(_abs "${SBOM_SCAN_ROOT}")
        else()
            set(_abs "${SBOM_SCAN_ROOT}/${_d}")
        endif()
        if(NOT IS_DIRECTORY "${_abs}")
            continue()
        endif()
        file(GLOB_RECURSE _hits LIST_DIRECTORIES true RELATIVE "${_abs}" "${_abs}/*")
        list(SORT _hits)
        set(_frameworks "")
        foreach(_rel IN LISTS _hits)
            set(_inside FALSE)
            foreach(_fw IN LISTS _frameworks)
                string(FIND "${_rel}" "${_fw}/" _pos)
                if(_pos EQUAL 0)
                    set(_inside TRUE)
                    break()
                endif()
            endforeach()
            if(_inside)
                continue()
            endif()
            set(_full "${_abs}/${_rel}")
            if(_rel MATCHES "[.]framework$" AND IS_DIRECTORY "${_full}")
                list(APPEND _frameworks "${_rel}")
            elseif(IS_SYMLINK "${_full}" OR IS_DIRECTORY "${_full}")
                continue()
            elseif(NOT _rel MATCHES "[.](dll|dylib|so)$|[.]so[.]")
                continue()
            endif()
            if(_d STREQUAL ".")
                set(_path "${_scan_prefix}${_rel}")
            else()
                set(_path "${_scan_prefix}${_d}/${_rel}")
            endif()
            set(_qt_tree FALSE)
            if(_rel MATCHES "/")
                set(_qt_tree TRUE)
            endif()
            _sbom_add_bundled("${_path}" "" "" "" "" "" ${_qt_tree})
        endforeach()
    endforeach()
endif()

if(SBOM_BUNDLE_MANIFEST)
    file(STRINGS "${SBOM_BUNDLE_MANIFEST}" _lines ENCODING UTF-8)
    list(SORT _lines)
    foreach(_line IN LISTS _lines)
        string(REPLACE "\t" ";" _cols "${_line};;;;;;")
        list(GET _cols 0 _path)
        list(GET _cols 1 _name)
        list(GET _cols 2 _ver)
        list(GET _cols 3 _sup)
        list(GET _cols 4 _purl)
        list(GET _cols 5 _lic)
        if(_path STREQUAL "")
            continue()
        endif()
        set(_qt_tree FALSE)
        if(_path MATCHES "(^|/)(plugins|qml)/")
            set(_qt_tree TRUE)
        endif()
        _sbom_add_bundled("${_path}" "${_name}" "${_ver}" "${_sup}" "${_purl}" "${_lic}" ${_qt_tree})
    endforeach()
endif()

# Only what is reachable from the root, sorted, so the output is stable.
list(REMOVE_DUPLICATES SBOM_COMPONENTS)
list(REMOVE_ITEM SBOM_COMPONENTS "")
foreach(_id IN LISTS SBOM_COMPONENTS)
    foreach(_p IN LISTS SBOM_${_id}_USED_BY)
        if(NOT _p STREQUAL _id)
            list(APPEND _children_${_p} ${_id})
        endif()
    endforeach()
endforeach()

set(_emit "${SBOM_ROOT}")
set(_queue "${SBOM_ROOT}")
while(_queue)
    list(POP_FRONT _queue _cur)
    foreach(_c IN LISTS _children_${_cur})
        if(NOT _c IN_LIST _emit)
            list(APPEND _emit ${_c})
            list(APPEND _queue ${_c})
        endif()
    endforeach()
endwhile()
list(REMOVE_ITEM _emit "${SBOM_ROOT}")
list(SORT _emit)

set(_edges "")
foreach(_id IN LISTS _emit)
    foreach(_p IN LISTS SBOM_${_id}_USED_BY)
        if(_p STREQUAL SBOM_ROOT OR _p IN_LIST _emit)
            list(APPEND _edges "${_p}|${SBOM_${_id}_RELATION}|${_id}")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES _edges)
list(SORT _edges)

set(_doc_name "${SBOM_${SBOM_ROOT}_NAME}-${IMAGER_VERSION_STR}-${SBOM_PLATFORM}")

# The hashed tree must be final: run after signing, never before.
set(_file_keys "")
set(_unhashed "")
if(SBOM_HASH_ROOT)
    if(NOT IS_DIRECTORY "${SBOM_HASH_ROOT}")
        message(FATAL_ERROR "GenerateSbom: SBOM_HASH_ROOT is not a directory: '${SBOM_HASH_ROOT}'")
    endif()
    # This run's own outputs cannot hash themselves.
    set(_sbom_dirs "")
    set(_skip "")
    foreach(_d IN LISTS SBOM_COPY_DIRS SBOM_OUTPUT_DIR)
        cmake_path(IS_PREFIX SBOM_HASH_ROOT "${_d}" NORMALIZE _inside)
        if(NOT _inside)
            continue()
        endif()
        file(RELATIVE_PATH _r "${SBOM_HASH_ROOT}" "${_d}")
        if(_r)
            string(APPEND _r "/")
        endif()
        if(_d STREQUAL SBOM_OUTPUT_DIR AND SBOM_OUTPUT_STEM)
            list(APPEND _skip "${_r}${SBOM_OUTPUT_STEM}.spdx.json" "${_r}${SBOM_OUTPUT_STEM}.cdx.json")
        else()
            list(APPEND _sbom_dirs "${_r}")
            list(APPEND _unhashed "${_r}${_doc_name}.spdx.json" "${_r}${_doc_name}.cdx.json")
        endif()
    endforeach()
    list(APPEND _unhashed ${_skip})

    foreach(_id IN LISTS SBOM_ROOT _emit)
        foreach(_p IN LISTS SBOM_${_id}_PATHS)
            string(MD5 _h "${_p}")
            set(_own_${_h} ${_id})
        endforeach()
        if(SBOM_${_id}_FILE_NAME)
            string(MD5 _h "${SBOM_${_id}_FILE_NAME}")
            set(_ownname_${_h} ${_id})
        endif()
    endforeach()

    file(GLOB_RECURSE _all LIST_DIRECTORIES false RELATIVE "${SBOM_HASH_ROOT}" "${SBOM_HASH_ROOT}/*")
    list(SORT _all)
    foreach(_rel IN LISTS _all)
        set(_abs "${SBOM_HASH_ROOT}/${_rel}")
        if(IS_SYMLINK "${_abs}" OR IS_DIRECTORY "${_abs}" OR _rel IN_LIST _skip)
            continue()
        endif()
        if(_rel IN_LIST SBOM_HASH_EXCLUDE)
            list(APPEND _unhashed "${_rel}")
            continue()
        endif()
        get_filename_component(_dir "${_rel}" DIRECTORY)
        if(_dir)
            string(APPEND _dir "/")
        endif()
        if(_dir IN_LIST _sbom_dirs AND _rel MATCHES "[.](spdx|cdx)[.]json$")
            continue()
        endif()

        # A bundled component owns its path and anything beneath it.
        set(_owner "")
        set(_p "${_rel}")
        while(_p AND NOT _owner)
            string(MD5 _h "${_p}")
            if(DEFINED _own_${_h})
                set(_owner ${_own_${_h}})
            endif()
            get_filename_component(_p "${_p}" DIRECTORY)
        endwhile()
        if(NOT _owner)
            get_filename_component(_n "${_rel}" NAME)
            string(MD5 _h "${_n}")
            if(DEFINED _ownname_${_h})
                set(_owner ${_ownname_${_h}})
            else()
                set(_owner ${SBOM_ROOT})
            endif()
        endif()

        string(SHA1 _k "${_rel}")
        string(SUBSTRING "${_k}" 0 16 _k)
        set(_fpath_${_k} "${_rel}")
        file(SHA1 "${_abs}" _fsha1_${_k})
        file(SHA256 "${_abs}" _fsha256_${_k})
        file(SHA512 "${_abs}" _fsha512_${_k})
        list(APPEND _file_keys ${_k})
        list(APPEND _files_of_${_owner} ${_k})
    endforeach()
    list(REMOVE_DUPLICATES _unhashed)
    list(SORT _unhashed)
endif()

set(_art_name "")
if(SBOM_ARTEFACT)
    if(NOT EXISTS "${SBOM_ARTEFACT}")
        message(FATAL_ERROR "GenerateSbom: SBOM_ARTEFACT not found: '${SBOM_ARTEFACT}'")
    endif()
    get_filename_component(_art_name "${SBOM_ARTEFACT}" NAME)
    file(SHA1 "${SBOM_ARTEFACT}" _art_sha1)
    file(SHA256 "${SBOM_ARTEFACT}" _art_sha256)
    file(SHA512 "${SBOM_ARTEFACT}" _art_sha512)
endif()

# Derived from content, not chance: an unchanged build gives an identical file.
set(_canon "${_doc_name}")
foreach(_id IN LISTS SBOM_ROOT _emit)
    foreach(_f IN LISTS _fields)
        string(APPEND _canon "|${SBOM_${_id}_${_f}}")
    endforeach()
endforeach()
foreach(_k IN LISTS _file_keys)
    string(APPEND _canon "|${_fpath_${_k}}=${_fsha256_${_k}}")
endforeach()
string(APPEND _canon "|${_art_name}=${_art_sha256}|${_unhashed}")
string(SHA256 _hash "${_canon}")
string(UUID _uuid
    NAMESPACE 6ba7b811-9dad-11d1-80b4-00c04fd430c8
    NAME "https://github.com/raspberrypi/rpi-imager/sbom/${_doc_name}/${_hash}"
    TYPE SHA1)

# string(TIMESTAMP) honours SOURCE_DATE_EPOCH.
string(TIMESTAMP _created "%Y-%m-%dT%H:%M:%SZ" UTC)

function(_j out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Members carry a leading ",\n" that _obj and _arr strip.
function(_add var indent key json)
    set(${var} "${${var}},\n${indent}\"${key}\": ${json}" PARENT_SCOPE)
endfunction()

function(_add_str var indent key value)
    _j(_v "${value}")
    set(${var} "${${var}},\n${indent}\"${key}\": ${_v}" PARENT_SCOPE)
endfunction()

function(_obj out body indent)
    string(SUBSTRING "${body}" 2 -1 body)
    set(${out} "{\n${body}\n${indent}}" PARENT_SCOPE)
endfunction()

function(_arr out items indent)
    if(items STREQUAL "")
        set(${out} "[]" PARENT_SCOPE)
        return()
    endif()
    string(SUBSTRING "${items}" 2 -1 items)
    set(${out} "[\n${items}\n${indent}]" PARENT_SCOPE)
endfunction()

function(_known out value)
    if(value STREQUAL "" OR value STREQUAL "NOASSERTION")
        set(${out} FALSE PARENT_SCOPE)
    else()
        set(${out} TRUE PARENT_SCOPE)
    endif()
endfunction()

function(_supplier_name out value)
    string(REGEX REPLACE "^(Person|Organization): *" "" value "${value}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# A component deployed as exactly one file: its file, for component hashes.
function(_single_file out id)
    set(${out} "" PARENT_SCOPE)
    list(LENGTH _files_of_${id} _n)
    if(_n EQUAL 1 AND NOT id STREQUAL SBOM_ROOT)
        set(${out} "${_files_of_${id}}" PARENT_SCOPE)
    endif()
endfunction()

function(_spdx_checksums out sha1 sha256 sha512)
    set(${out} "[ { \"algorithm\": \"SHA1\", \"checksumValue\": \"${sha1}\" }, { \"algorithm\": \"SHA256\", \"checksumValue\": \"${sha256}\" }, { \"algorithm\": \"SHA512\", \"checksumValue\": \"${sha512}\" } ]" PARENT_SCOPE)
endfunction()

function(_spdx_package out id)
    set(I "      ")
    set(_m "")
    _add_str(_m "${I}" "SPDXID" "SPDXRef-Package-${id}")
    _add_str(_m "${I}" "name" "${SBOM_${id}_NAME}")
    _known(_k "${SBOM_${id}_VERSION}")
    if(_k)
        _add_str(_m "${I}" "versionInfo" "${SBOM_${id}_VERSION}")
    endif()

    set(_sup "${SBOM_${id}_SUPPLIER}")
    _known(_k "${_sup}")
    if(NOT _k)
        set(_sup NOASSERTION)
    elseif(NOT _sup MATCHES "^(Person|Organization): ")
        set(_sup "Organization: ${_sup}")
    endif()
    _add_str(_m "${I}" "supplier" "${_sup}")

    set(_rev "${SBOM_${id}_COMMIT}")
    if(NOT _rev)
        set(_rev "${SBOM_${id}_GIT_TAG}")
    endif()
    if(SBOM_${id}_VCS_URL AND _rev)
        set(_dl "git+${SBOM_${id}_VCS_URL}@${_rev}")
    elseif(SBOM_${id}_DOWNLOAD_LOCATION)
        set(_dl "${SBOM_${id}_DOWNLOAD_LOCATION}")
    else()
        set(_dl NOASSERTION)
    endif()
    _add_str(_m "${I}" "downloadLocation" "${_dl}")
    _single_file(_single ${id})
    if(id STREQUAL SBOM_ROOT AND _art_name)
        _add_str(_m "${I}" "packageFileName" "${_art_name}")
        _spdx_checksums(_c "${_art_sha1}" "${_art_sha256}" "${_art_sha512}")
        _add(_m "${I}" "checksums" "${_c}")
    elseif(_single)
        get_filename_component(_fn "${_fpath_${_single}}" NAME)
        _add_str(_m "${I}" "packageFileName" "${_fn}")
        _spdx_checksums(_c "${_fsha1_${_single}}" "${_fsha256_${_single}}" "${_fsha512_${_single}}")
        _add(_m "${I}" "checksums" "${_c}")
    endif()
    if(_files_of_${id})
        _add(_m "${I}" "filesAnalyzed" "true")
        # SPDX 2.3 section 7.9: SHA-1 over the files' sorted SHA-1s.
        set(_ids "")
        set(_sums "")
        foreach(_k IN LISTS _files_of_${id})
            _j(_v "SPDXRef-File-${_k}")
            string(APPEND _ids ",\n${I}  ${_v}")
            list(APPEND _sums "${_fsha1_${_k}}")
        endforeach()
        list(SORT _sums)
        list(JOIN _sums "" _sums)
        string(SHA1 _vc "${_sums}")
        set(_pvc "")
        _add_str(_pvc "${I}  " "packageVerificationCodeValue" "${_vc}")
        if(id STREQUAL SBOM_ROOT AND _unhashed)
            set(_x "")
            foreach(_u IN LISTS _unhashed)
                _j(_u "./${_u}")
                string(APPEND _x ",\n${I}    ${_u}")
            endforeach()
            _arr(_x "${_x}" "${I}  ")
            _add(_pvc "${I}  " "packageVerificationCodeExcludedFiles" "${_x}")
        endif()
        _obj(_pvc "${_pvc}" "${I}")
        _add(_m "${I}" "packageVerificationCode" "${_pvc}")
        _arr(_ids "${_ids}" "${I}")
        _add(_m "${I}" "hasFiles" "${_ids}")
    else()
        _add(_m "${I}" "filesAnalyzed" "false")
    endif()
    _add_str(_m "${I}" "licenseConcluded" "NOASSERTION")
    _add_str(_m "${I}" "licenseDeclared" "${SBOM_${id}_LICENSE}")
    _add_str(_m "${I}" "copyrightText" "NOASSERTION")

    set(_purpose LIBRARY)
    if(SBOM_${id}_TYPE STREQUAL "application")
        set(_purpose APPLICATION)
    elseif(SBOM_${id}_TYPE STREQUAL "framework")
        set(_purpose FRAMEWORK)
    elseif(SBOM_${id}_TYPE STREQUAL "data")
        set(_purpose OTHER)
    endif()
    _add_str(_m "${I}" "primaryPackagePurpose" "${_purpose}")
    if(id STREQUAL SBOM_ROOT)
        _add_str(_m "${I}" "builtDate" "${_created}")
    endif()

    set(_src "")
    if(SBOM_${id}_GIT_TAG)
        list(APPEND _src "git tag ${SBOM_${id}_GIT_TAG}")
    endif()
    if(SBOM_${id}_COMMIT)
        list(APPEND _src "commit ${SBOM_${id}_COMMIT}")
    endif()
    if(SBOM_${id}_ORIGIN)
        list(APPEND _src "${SBOM_${id}_ORIGIN}")
    endif()
    if(_src)
        list(JOIN _src "; " _src)
        _add_str(_m "${I}" "sourceInfo" "${_src}")
    endif()
    if(SBOM_${id}_DESCRIPTION)
        _add_str(_m "${I}" "description" "${SBOM_${id}_DESCRIPTION}")
    endif()
    set(_note "")
    if(id STREQUAL SBOM_ROOT)
        list(APPEND _note "Built for ${SBOM_PLATFORM}")
    endif()
    if(SBOM_${id}_PATHS)
        list(JOIN SBOM_${id}_PATHS ", " _paths)
        list(APPEND _note "Bundled as: ${_paths}")
    endif()
    if(_note)
        list(JOIN _note "; " _note)
        _add_str(_m "${I}" "comment" "${_note}")
    endif()

    set(_refs "")
    if(SBOM_${id}_PURL)
        set(_r "")
        _add_str(_r "${I}    " "referenceCategory" "PACKAGE-MANAGER")
        _add_str(_r "${I}    " "referenceType" "purl")
        _add_str(_r "${I}    " "referenceLocator" "${SBOM_${id}_PURL}")
        _obj(_r "${_r}" "${I}  ")
        string(APPEND _refs ",\n${I}  ${_r}")
    endif()
    if(SBOM_${id}_CPE)
        set(_r "")
        _add_str(_r "${I}    " "referenceCategory" "SECURITY")
        _add_str(_r "${I}    " "referenceType" "cpe23Type")
        _add_str(_r "${I}    " "referenceLocator" "${SBOM_${id}_CPE}")
        _obj(_r "${_r}" "${I}  ")
        string(APPEND _refs ",\n${I}  ${_r}")
    endif()
    if(_refs)
        _arr(_refs "${_refs}" "${I}")
        _add(_m "${I}" "externalRefs" "${_refs}")
    endif()

    _obj(_pkg "${_m}" "    ")
    set(${out} "${_pkg}" PARENT_SCOPE)
endfunction()

set(_packages "")
set(_licrefs "")
foreach(_id IN LISTS SBOM_ROOT _emit)
    _spdx_package(_p ${_id})
    string(APPEND _packages ",\n    ${_p}")
    string(REGEX MATCHALL "LicenseRef-[A-Za-z0-9.-]+" _refs "${SBOM_${_id}_LICENSE}")
    foreach(_r IN LISTS _refs)
        if(NOT _r IN_LIST _licrefs)
            list(APPEND _licrefs ${_r})
            set(_licref_text_${_r} "${SBOM_${_id}_LICENSE_TEXT}")
        endif()
    endforeach()
endforeach()
_arr(_packages "${_packages}" "  ")

set(_spdx_files "")
foreach(_k IN LISTS _file_keys)
