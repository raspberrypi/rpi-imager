    _add_str(_r "      " "relationshipType" "${_type}")
    _add_str(_r "      " "relatedSpdxElement" "SPDXRef-Package-${_to}")
    _obj(_r "${_r}" "    ")
    string(APPEND _rels ",\n    ${_r}")
endforeach()
_arr(_rels "${_rels}" "  ")

# CISA's generation context and known unknowns, which SPDX 2.3 has no field for.
set(_context "Generation context: ${SBOM_LIFECYCLE}. Known unknowns: dependencies of the listed components are not enumerated; licences marked NOASSERTION are undetermined.")
if(_unhashed)
    string(APPEND _context " Not hashed, as they are sealed after this document is written: see packageVerificationCodeExcludedFiles.")
endif()
if(SBOM_SECURITY_CONTACT)
    string(APPEND _context " Security contact: ${SBOM_SECURITY_CONTACT}")
endif()

set(_doc "")
_add_str(_doc "  " "spdxVersion" "SPDX-2.3")
_add_str(_doc "  " "dataLicense" "CC0-1.0")
_add_str(_doc "  " "SPDXID" "SPDXRef-DOCUMENT")
_add_str(_doc "  " "name" "${_doc_name}")
_add_str(_doc "  " "documentNamespace"
    "https://github.com/raspberrypi/rpi-imager/spdx/${_doc_name}-${_uuid}")
set(_ci "")
_add_str(_ci "    " "created" "${_created}")
_j(_c1 "Organization: Raspberry Pi Ltd")
_j(_c2 "Tool: rpi-imager-GenerateSbom.cmake-${IMAGER_VERSION_STR}")
_add(_ci "    " "creators" "[${_c1}, ${_c2}]")
_add_str(_ci "    " "comment" "${_context}")
_obj(_ci "${_ci}" "  ")
_add(_doc "  " "creationInfo" "${_ci}")
if(_licrefs)
    set(_x "")
    foreach(_r IN LISTS _licrefs)
        set(_t "${_licref_text_${_r}}")
        if(NOT _t)
            set(_t "See the component's own licence notice.")
        endif()
        string(REPLACE "LicenseRef-" "" _n "${_r}")
        string(REPLACE "-" " " _n "${_n}")
        set(_o "")
        _add_str(_o "      " "licenseId" "${_r}")
        _add_str(_o "      " "name" "${_n}")
        _add_str(_o "      " "extractedText" "${_t}")
        _obj(_o "${_o}" "    ")
        string(APPEND _x ",\n    ${_o}")
    endforeach()
    _arr(_x "${_x}" "  ")
    _add(_doc "  " "hasExtractedLicensingInfos" "${_x}")
endif()
_add(_doc "  " "packages" "${_packages}")
if(_spdx_files)
    _arr(_spdx_files "${_spdx_files}" "  ")
    _add(_doc "  " "files" "${_spdx_files}")
endif()
_add(_doc "  " "relationships" "${_rels}")
_obj(_spdx "${_doc}" "")

function(_cdx_hashes out sha1 sha256 sha512)
    set(${out} "[ { \"alg\": \"SHA-1\", \"content\": \"${sha1}\" }, { \"alg\": \"SHA-256\", \"content\": \"${sha256}\" }, { \"alg\": \"SHA-512\", \"content\": \"${sha512}\" } ]" PARENT_SCOPE)
endfunction()

function(_cdx_files out keys indent)
    set(_r "")
    foreach(_k IN LISTS keys)
        _j(_p "${_fpath_${_k}}")
        _cdx_hashes(_h "${_fsha1_${_k}}" "${_fsha256_${_k}}" "${_fsha512_${_k}}")
        string(APPEND _r ",\n${indent}  { \"type\": \"file\", \"bom-ref\": \"file-${_k}\", \"name\": ${_p}, \"hashes\": ${_h} }")
    endforeach()
    set(${out} "${_r}" PARENT_SCOPE)
endfunction()

function(_supplier_url out id)
    set(_u "${SBOM_${id}_DOWNLOAD_LOCATION}")
    if(NOT _u)
        set(_u "${SBOM_${id}_VCS_URL}")
    endif()
    if(SBOM_${id}_PURL MATCHES "^pkg:github/raspberrypi/")
        set(_u "https://www.raspberrypi.com")
    endif()
    if(NOT _u MATCHES "^https?://")
        set(_u "")
    endif()
    set(${out} "${_u}" PARENT_SCOPE)
endfunction()

function(_cdx_component out id indent)
    set(I "${indent}  ")
    set(_type "${SBOM_${id}_TYPE}")
    if(NOT _type)
        set(_type library)
    endif()
    set(_m "")
    _add_str(_m "${I}" "type" "${_type}")
    _add_str(_m "${I}" "bom-ref" "${id}")
    _single_file(_single ${id})
    _known(_k "${SBOM_${id}_SUPPLIER}")
    if(_k)
        _supplier_name(_s "${SBOM_${id}_SUPPLIER}")
        _j(_s "${_s}")
        _supplier_url(_u ${id})
        if(_u)
            _j(_u "${_u}")
            _add(_m "${I}" "supplier" "{ \"name\": ${_s}, \"url\": [ ${_u} ] }")
        else()
            _add(_m "${I}" "supplier" "{ \"name\": ${_s} }")
        endif()
    endif()
    _add_str(_m "${I}" "name" "${SBOM_${id}_NAME}")
    _known(_k "${SBOM_${id}_VERSION}")
    if(_k)
        _add_str(_m "${I}" "version" "${SBOM_${id}_VERSION}")
    endif()
    if(SBOM_${id}_DESCRIPTION)
        _add_str(_m "${I}" "description" "${SBOM_${id}_DESCRIPTION}")
    endif()
    _known(_k "${SBOM_${id}_LICENSE}")
    if(_k)
        _j(_l "${SBOM_${id}_LICENSE}")
        _add(_m "${I}" "licenses" "[ { \"expression\": ${_l}, \"acknowledgement\": \"declared\" } ]")
    endif()
    if(SBOM_${id}_CPE)
        _add_str(_m "${I}" "cpe" "${SBOM_${id}_CPE}")
    endif()
    if(SBOM_${id}_PURL)
        _add_str(_m "${I}" "purl" "${SBOM_${id}_PURL}")
    endif()
    if(id STREQUAL SBOM_ROOT AND _art_name)
        _cdx_hashes(_h "${_art_sha1}" "${_art_sha256}" "${_art_sha512}")
        _add(_m "${I}" "hashes" "${_h}")
    elseif(_single)
        _cdx_hashes(_h "${_fsha1_${_single}}" "${_fsha256_${_single}}" "${_fsha512_${_single}}")
        _add(_m "${I}" "hashes" "${_h}")
    endif()

    set(_refs "")
    if(SBOM_${id}_VCS_URL)
        _j(_u "${SBOM_${id}_VCS_URL}")
        string(APPEND _refs ",\n${I}  { \"type\": \"vcs\", \"url\": ${_u} }")
    endif()
    if(SBOM_${id}_DOWNLOAD_LOCATION)
        _j(_u "${SBOM_${id}_DOWNLOAD_LOCATION}")
        string(APPEND _refs ",\n${I}  { \"type\": \"distribution\", \"url\": ${_u} }")
    endif()
    if(id STREQUAL SBOM_ROOT AND SBOM_SECURITY_CONTACT)
        _j(_u "${SBOM_SECURITY_CONTACT}")
        string(APPEND _refs ",\n${I}  { \"type\": \"security-contact\", \"url\": ${_u} }")
    endif()
    if(_refs)
        _arr(_refs "${_refs}" "${I}")
        _add(_m "${I}" "externalReferences" "${_refs}")
    endif()

    set(_props "")
    foreach(_p GIT_TAG:git-tag COMMIT:git-commit ORIGIN:origin)
        string(REPLACE ":" ";" _p "${_p}")
        list(GET _p 0 _f)
        list(GET _p 1 _n)
        if(SBOM_${id}_${_f})
            _j(_v "${SBOM_${id}_${_f}}")
            string(APPEND _props ",\n${I}  { \"name\": \"rpi-imager:${_n}\", \"value\": ${_v} }")
        endif()
    endforeach()
    foreach(_path IN LISTS SBOM_${id}_PATHS)
        _j(_v "${_path}")
        string(APPEND _props ",\n${I}  { \"name\": \"rpi-imager:path\", \"value\": ${_v} }")
    endforeach()
    # BSI TR-03183-2 component properties, which the CRA guidance cites.
    set(_fn "${SBOM_${id}_FILE_NAME}")
    if(_single)
        get_filename_component(_fn "${_fpath_${_single}}" NAME)
    endif()
    # The root's hashes are the artefact's, so its filename and shape must be
    # too. An installer, AppImage or disk image is an archive whose contents
    # are listed here.
    set(_archive "no archive")
    set(_structured unstructured)
    if(id STREQUAL SBOM_ROOT AND _art_name)
        set(_fn "${_art_name}")
        set(_archive archive)
        set(_structured structured)
    endif()
    if(_fn)
        _j(_v "${_fn}")
        string(APPEND _props ",\n${I}  { \"name\": \"bsi:component:filename\", \"value\": ${_v} }")
    endif()
    set(_exe executable)
    if(_type STREQUAL "data")
        set(_exe non-executable)
    endif()
    string(APPEND _props ",\n${I}  { \"name\": \"bsi:component:executable\", \"value\": \"${_exe}\" }")
    string(APPEND _props ",\n${I}  { \"name\": \"bsi:component:archive\", \"value\": \"${_archive}\" }")
    string(APPEND _props ",\n${I}  { \"name\": \"bsi:component:structured\", \"value\": \"${_structured}\" }")
    if(id STREQUAL SBOM_ROOT)
        if(_art_name)
            _j(_v "${_art_name}")
            string(APPEND _props ",\n${I}  { \"name\": \"rpi-imager:artefact\", \"value\": ${_v} }")
        endif()
        foreach(_u IN LISTS _unhashed)
            _j(_v "${_u}")
            string(APPEND _props ",\n${I}  { \"name\": \"rpi-imager:unhashed\", \"value\": ${_v} }")
        endforeach()
    endif()
    if(_props)
        _arr(_props "${_props}" "${I}")
        _add(_m "${I}" "properties" "${_props}")
    endif()
    # The root's files are the BOM's top-level components.
    if(_files_of_${id} AND NOT id STREQUAL SBOM_ROOT)
        _cdx_files(_f "${_files_of_${id}}" "${I}")
        _arr(_f "${_f}" "${I}")
        _add(_m "${I}" "components" "${_f}")
    endif()

    _obj(_c "${_m}" "${indent}")
    set(${out} "${_c}" PARENT_SCOPE)
endfunction()

set(_components "")
foreach(_id IN LISTS _emit)
    _cdx_component(_c ${_id} "    ")
    string(APPEND _components ",\n    ${_c}")
endforeach()
_cdx_files(_f "${_files_of_${SBOM_ROOT}}" "  ")
string(APPEND _components "${_f}")
_arr(_components "${_components}" "  ")

set(_deps "")
foreach(_id IN LISTS SBOM_ROOT _emit)
    set(_on "")
    foreach(_e IN LISTS _edges)
        string(REPLACE "|" ";" _e "${_e}")
        list(GET _e 0 _from)
        list(GET _e 2 _to)
        if(_from STREQUAL _id)
            _j(_t "${_to}")
            string(APPEND _on ",\n        ${_t}")
        endif()
    endforeach()
    _arr(_on "${_on}" "      ")
    _j(_ref "${_id}")
    string(APPEND _deps ",\n    {\n      \"ref\": ${_ref},\n      \"dependsOn\": ${_on}\n    }")
endforeach()
_arr(_deps "${_deps}" "  ")

_cdx_component(_root ${SBOM_ROOT} "    ")
set(_meta "")
_add_str(_meta "    " "timestamp" "${_created}")
_add(_meta "    " "lifecycles" "[ { \"phase\": \"${SBOM_LIFECYCLE}\" } ]")
_add(_meta "    " "tools"
    "{ \"components\": [ { \"type\": \"application\", \"name\": \"rpi-imager GenerateSbom.cmake\", \"version\": \"${IMAGER_VERSION_STR}\" } ] }")
set(_rpl "{ \"name\": \"Raspberry Pi Ltd\", \"url\": [ \"https://www.raspberrypi.com\" ] }")
_add(_meta "    " "authors" "[ { \"name\": \"Raspberry Pi Ltd\" } ]")
_add(_meta "    " "manufacturer" "${_rpl}")
_add(_meta "    " "supplier" "${_rpl}")
_add(_meta "    " "component" "${_root}")
_j(_plat "${SBOM_PLATFORM}")
_add(_meta "    " "properties" "[ { \"name\": \"rpi-imager:platform\", \"value\": ${_plat} } ]")
_obj(_meta "${_meta}" "  ")

set(_bom "")
_add_str(_bom "  " "bomFormat" "CycloneDX")
_add_str(_bom "  " "specVersion" "1.6")
_add_str(_bom "  " "serialNumber" "urn:uuid:${_uuid}")
_add(_bom "  " "version" "1")
_add(_bom "  " "metadata" "${_meta}")
_add(_bom "  " "components" "${_components}")
_add(_bom "  " "dependencies" "${_deps}")
_add(_bom "  " "compositions" "[ { \"aggregate\": \"incomplete\", \"assemblies\": [ \"${SBOM_ROOT}\" ] } ]")
_obj(_cdx "${_bom}" "")

# An older version's files would otherwise ship beside the new ones.
function(_write_into dir)
    file(MAKE_DIRECTORY "${dir}")
    file(GLOB _stale "${dir}/*.spdx.json" "${dir}/*.cdx.json")
    if(_stale)
        file(REMOVE ${_stale})
    endif()
    file(WRITE "${dir}/${_doc_name}.spdx.json" "${_spdx}\n")
    file(WRITE "${dir}/${_doc_name}.cdx.json" "${_cdx}\n")
endfunction()

# A stem names a copy beside an artefact, among other artefacts' copies.
if(SBOM_OUTPUT_STEM)
    set(_out "${SBOM_OUTPUT_DIR}/${SBOM_OUTPUT_STEM}")
    file(WRITE "${_out}.spdx.json" "${_spdx}\n")
    file(WRITE "${_out}.cdx.json" "${_cdx}\n")
else()
    set(_out "${SBOM_OUTPUT_DIR}/${_doc_name}")
    _write_into("${SBOM_OUTPUT_DIR}")
endif()
foreach(_d IN LISTS SBOM_COPY_DIRS)
    _write_into("${_d}")
endforeach()
if(SBOM_STAMP)
    file(WRITE "${SBOM_STAMP}" "${_doc_name}\n")
endif()

list(LENGTH _emit _n)
list(LENGTH _file_keys _nf)
list(LENGTH _unhashed _nu)
message(STATUS "SBOM: ${_out}.{spdx,cdx}.json (${_n} components, ${_nf} files hashed, ${_nu} unhashed)")
