    _spdx_checksums(_c "${_fsha1_${_k}}" "${_fsha256_${_k}}" "${_fsha512_${_k}}")
    _add(_f "      " "checksums" "${_c}")
    _add_str(_f "      " "licenseConcluded" "NOASSERTION")
    _add_str(_f "      " "copyrightText" "NOASSERTION")
    _obj(_f "${_f}" "    ")
    string(APPEND _spdx_files ",\n    ${_f}")
endforeach()

set(_rels "")
set(_r "")
_add_str(_r "      " "spdxElementId" "SPDXRef-DOCUMENT")
_add_str(_r "      " "relationshipType" "DESCRIBES")
